{
  // Picture settings. Every name may be left out: then that part stays as in the original.
  "antiAliasing": 8,        // 0, 2, 4 or 8 samples on polygon edges
  "textureSamples": 4,      // 1..8: far textures stop shimmering (1 = original)
  "fogDistance": 1,         // 0.25..8: factor on the mission's fog distance (1 = original)

  // Colour of the 3D view (1 = unchanged). The HUD keeps its colours.
  "brightness": 1.0,
  "contrast": 1.12,
  "saturation": 1.1,
  "gamma": 1.0,
  "sharpen": 0.25,          // 0..2
  "vignette": 0.2,          // 0..1, darker corners

  "bloom": {
    "intensity": 0.5,       // 0..4, 0 = off
    "threshold": 0.75,      // 0..1, how bright a pixel must be to glow
    "soft": 0.5,            // 0..1, softness of that edge
    "radius": 5             // 1..8, size of the glow
  }
}
